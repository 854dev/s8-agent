{
  "name": "s8-pi-environment",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Canonical Pi configuration and package environment for s8",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "start": "node bin/start.mjs",
    "supervisor": "node bin/start.mjs --service supervisor",
    "console": "node bin/projectman-console.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@ph-cms/client-sdk": "0.1.61",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  }
}
