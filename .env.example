# start-pi.sh와 start-pi-web-ui.sh의 작업 디렉터리
# 상대 경로는 s8-agent 루트 기준
S8_KB_ROOT=../854_md

# Nginx 바인딩은 필수. 원격 접속 시 실제 Tailscale IPv4로 변경한다.
# 웹 터미널에는 별도 인증이 없으므로 0.0.0.0을 사용하지 않는다.
NGINX_BIND_IP=127.0.0.1

# PI_WEB_HOST=127.0.0.1
# PI_WEB_PORT=8788

# Projectman (설정하지 않으면 새 도구만 사용할 수 없음)
# PHCMS_API_URL=http://127.0.0.1:8000/api/v2
# PHCMS_ACCESS_TOKEN=발급받은_에이전트_계정_토큰

# Telegram Gateway (둘 중 하나 이상의 허용 목록을 설정)
# TELEGRAM_BOT_TOKEN=BotFather에서_발급받은_토큰
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# TELEGRAM_ALLOWED_GROUP_IDS=-1001234567890,-1009876543210
