# start-pi.sh와 start-pi-web-ui.sh의 작업 디렉터리
# 상대 경로는 s8-agent 루트 기준
S8_KB_ROOT=../854_md

# Nginx 바인딩은 필수. 원격 접속 시 실제 Tailscale IPv4로 변경한다.
# 웹 터미널에는 별도 인증이 없으므로 0.0.0.0을 사용하지 않는다.
NGINX_BIND_IP=127.0.0.1

# PI_WEB_HOST=127.0.0.1
# PI_WEB_PORT=8788

# Projectman (설정하지 않으면 새 도구만 사용할 수 없음)
# PHCMS_API_URL=http://127.0.0.1:8000/api/v2
# PHCMS_ACCESS_TOKEN=발급받은_에이전트_서비스_키
# 서비스 키는 S8이 보관한다. 직접 API 도구와 카운트 테스트 MCP 요청의 Authorization 헤더에 사용한다.
# MCP 설정은 PH-CMS packages/content-mcp/README.md를 참고한다.

# Telegram: 봇 토큰은 환경변수에 유지한다. ID 설정은 s8-config.yml을 권장한다.
# TELEGRAM_BOT_TOKEN=BotFather에서_발급받은_토큰
# 아래 ID 변수는 s8-config.yml이 없을 때만 사용하는 하위 호환 설정이다.
# 파일이 있으면 허용 목록과 예약 알림 대상 모두 파일만 사용하며 환경변수와 합치지 않는다.
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# TELEGRAM_ALLOWED_GROUP_IDS=-1001234567890,-1009876543210
# 기존 예약 알림 chat ID (위 허용 목록 중 하나와 일치해야 함; 파일이 있으면 무시)
# S8_SCHEDULE_TELEGRAM_CHAT_ID=123456789
