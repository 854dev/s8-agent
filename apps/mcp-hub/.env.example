MCP_HUB_HOST=127.0.0.1
MCP_HUB_PORT=8790
MCP_HUB_USER=local

# 기본값은 s8-agent의 형제 디렉터리인 ../854_md
# S8_KB_ROOT=/absolute/path/to/854_md

MCP_GMAIL_ENABLED=1
# MCP_GMAIL_OAUTH_PATH=.s8-runtime/mcp-hub/gmail/gcp-oauth.keys.json
# MCP_GMAIL_TOKEN_DIR=.s8-runtime/mcp-hub/gmail/tokens
# MCP_GMAIL_ENABLED_TOOLS=search_emails,read_email,draft_email,send_email

MCP_GOOGLE_CALENDAR_ENABLED=1
# MCP_GOOGLE_CALENDAR_OAUTH_PATH=.s8-runtime/mcp-hub/google-calendar/gcp-oauth.keys.json
# MCP_GOOGLE_CALENDAR_TOKEN_DIR=.s8-runtime/mcp-hub/google-calendar/tokens
# MCP_GOOGLE_CALENDAR_ENABLED_TOOLS=list-events,search-events,get-event,create-event,update-event,manage-accounts
