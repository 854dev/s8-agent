{
  "name": "s8-mcp-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/tests/*.test.js",
    "auth": "node --env-file-if-exists=.env --import tsx src/auth.ts"
  },
  "dependencies": {
    "@cocal/google-calendar-mcp": "2.6.3",
    "@gongrzhe/server-gmail-autoauth-mcp": "1.1.11",
    "@modelcontextprotocol/sdk": "1.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
